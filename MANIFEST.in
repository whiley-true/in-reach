# The source distribution carries the C++ the wheel's compiled module is built from (see native/README.md),
# but not build output or the prebuilt module.
graft native
global-exclude *.pyc
global-exclude __pycache__
prune native/build
# ...and no compiled files at all: the sdist is the C++ (and everything else) to build them from.
prune src/in_reach/app/rvt/native
